{
  "name": "E-Tech AI - Analytics",
  "nodes": [
    {
      "parameters": {
        "rule": "everyDay",
        "hour": 8,
        "minute": 0
      },
      "id": "schedule",
      "name": "Daily 8h",
      "type": "n8n-nodes-base.scheduleTrigger",
      "position": [
        100,
        300
      ],
      "typeVersion": 1.3
    },
    {
      "parameters": {
        "url": "http://127.0.0.1:11434/api/generate",
        "method": "POST",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "model",
              "value": "llama3.1:8b"
            },
            {
              "name": "prompt",
              "value": "Tu es l'analyste E-Tech. G\u00e9n\u00e8re un rapport quotidien avec: 1) Ventes du jour 2) Top 3 produits 3) Alertes stock 4) Recommandations pour demain. Format: Markdown avec \u00e9mojis."
            },
            {
              "name": "stream",
              "value": false
            }
          ]
        },
        "options": {
          "timeout": 120000
        }
      },
      "id": "ollama",
      "name": "Ollama AI",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        300,
        300
      ],
      "typeVersion": 4.1
    },
    {
      "parameters": {
        "fromEmail": "noreply@e-tech.bj",
        "toEmail": "electronbusiness07@gmail.com",
        "subject": "\ud83d\udcca E-Tech - Rapport Analytique Quotidien",
        "text": "={{ $json.response }}"
      },
      "id": "email",
      "name": "Send Email",
      "type": "n8n-nodes-base.emailSend",
      "position": [
        500,
        300
      ],
      "typeVersion": 2
    }
  ],
  "connections": {
    "Daily 8h": {
      "main": [
        [
          {
            "node": "Ollama AI",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Ollama AI": {
      "main": [
        [
          {
            "node": "Send Email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {},
  "version": 1
}