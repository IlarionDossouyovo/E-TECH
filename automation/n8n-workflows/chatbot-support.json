      "id": "claude-ai",
      "name": "Claude AI",
      "type": "n8n-nodes-base.anthropic",
      "typeVersion": 1,
      "position": [650, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"reply\": {{$json.content}},\n  \"type\": \"ai\"\n}"
      },
      "id": "respond",
      "name": "Respond",
