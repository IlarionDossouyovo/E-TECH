# E-Tech Environment Variables Template
# Copiez ceci dans .env et remplissez vos valeurs

# ===================
# DOMAINE & SITE
# ===================
SITE_URL=https://e-tech.bj
SITE_NAME=E-Tech
ADMIN_EMAIL=electronbusiness07@gmail.com

# ===================
# AI PROVIDER - GOOGLE GEMINI
# ===================
GOOGLE_API_KEY=your_google_gemini_api_key
GOOGLE_MODEL=gemini-2.0-flash-exp
GOOGLE_MAX_TOKENS=8192

# ===================
# AI PROVIDER - OLLAMA (Local)
# ===================
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# ===================
# AI PROVIDER CONFIGURATION
# ===================
AI_DEFAULT_PROVIDER=google  # Options: google, ollama
AI_FALLBACK_ENABLED=true
AI_MAX_COST_PER_DAY=10.00  # USD
AI_CONTEXT_LIMIT=100000

# ===================
# STRIPE (Paiements)
# ===================
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ===================
# PAYPAL
# ===================
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_secret

# ===================
# MOBILE MONEY (Bénin)
# ===================
MTN_MOMO_API_KEY=your_mtn_key
MOOV_MONEY_API_KEY=your_moov_key

# ===================
# DHL / FEDEX
# ===================
DHL_API_KEY=your_dhl_key
FEDEX_API_KEY=your_fedex_key

# ===================
# GOOGLE SHEETS
# ===================
GOOGLE_SHEETS_ID=your_google_spreadsheet_id
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account"}

# ===================
# DATABASE
# ===================
DATABASE_URL=postgresql://user:password@localhost:5432/etech
POSTGRES_USER=etech
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=etech

# ===================
# REDIS (Cache & Sessions)
# ===================
REDIS_URL=redis://localhost:6379

# ===================
# SECURITY
# ===================
JWT_SECRET=your_32_character_jwt_secret
SESSION_SECRET=your_session_secret
MFA_ENABLED=true

# ===================
# FOUNDER ACCESS
# ===================
FOUNDER_EMAIL=electronbusiness07@gmail.com
FOUNDER_MFA_SECRET=your_mfa_secret